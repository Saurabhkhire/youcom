# Copy this file to .env and fill in your keys. Leave blank to run in Demo Mode.

# --- Research (required for live mode) ---
YDC_API_KEY=

# --- Language model: pick ONE provider. Both use the OpenAI chat-completions format. ---
# LLM_PROVIDER=openai        # or "parasail". If unset, whichever provider has keys is used.

# Option A: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional (Azure, proxies, etc.)

# Option B: Parasail
PARASAIL_API_KEY=
PARASAIL_MODEL=
# List Parasail models:  curl https://api.parasail.io/v1/models -H "Authorization: Bearer $PARASAIL_API_KEY"

# --- Optional ---
# PORT=3000
# DEMO_DELAY=1           # 0 = instant demo replay, 2 = slower
# DEMO_LIVE_WEATHER=1    # use the real sky in demo mode
